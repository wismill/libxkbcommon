xkb_keymap {
xkb_keycodes {
	minimum = 1;
	maximum = 255;
	<>                   = 1;
};

xkb_types {
	type "ONE_LEVEL" {
		modifiers= none;
	};
};

xkb_compatibility {
	interpret.useModMapMods= AnyLevel;
	interpret.repeat= False;
	interpret VoidSymbol+AnyOfOrNone(none) {
		action= NoAction();
	};
};

xkb_symbols {
	key <>                   {
		repeat= No,
		symbols[1]= [                       NoSymbol ],
		actions[1]= [             SetGroup(group=+0) ],
		symbols[2]= [                       NoSymbol ],
		actions[2]= [           LatchGroup(group=+0) ],
		symbols[3]= [                       NoSymbol ],
		actions[3]= [            LockGroup(group=+0) ]
	};
};

};
